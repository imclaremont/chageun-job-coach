# 사용법: .env.local로 복사 후 값 입력 (cp .env.example .env.local)
# .env.local은 git 제외, 실제 키는 파일·문서·대화에 붙여넣기 금지

# OpenAI API 키 (서버 전용)
OPENAI_API_KEY=

# 사용할 모델 (기본값 gpt-5-mini)
# OPENAI_MODEL=gpt-5-mini

# 추론 강도 (minimal | low | medium | high), 생략 시 모델 기본값
# OPENAI_REASONING_EFFORT=low

# 배포 환경 저장소: Upstash Redis REST (Vercel 연동 시 자동 주입)
# 미설정 시 로컬은 .data/store.json 파일, Vercel은 메모리 사용
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
