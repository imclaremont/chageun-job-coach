# 사용법: .env.local로 복사 후 값 입력 (cp .env.example .env.local)
# 또는 값 출력 없이 기록: bash scripts/set-env.sh 이름=값
# .env.local은 git 제외, 실제 키는 코드·문서·커밋에 포함 금지

# AI 연결 (둘 중 하나), Azure 값이 모두 있으면 Azure 우선
# 1) Azure OpenAI
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
# 배포 이름, 모델 이름 역할
AZURE_OPENAI_DEPLOYMENT_NAME=
# 생략 시 2024-12-01-preview
# AZURE_OPENAI_API_VERSION=2024-12-01-preview

# 2) OpenAI 직접 연결
# OPENAI_API_KEY=
# 기본값 gpt-5-mini
# OPENAI_MODEL=gpt-5-mini

# 응답 변동 폭 (0~2), 낮을수록 일정한 결과, 추론 모델에서는 생략
# OPENAI_TEMPERATURE=0.2

# 추론 모델의 추론 강도 (minimal | low | medium | high), 생략 시 모델 기본값
# OPENAI_REASONING_EFFORT=low

# 배포 환경 저장소: Upstash Redis REST (Vercel 연동 시 자동 주입)
# 미설정 시 로컬은 .data/store.json 파일, Vercel은 메모리 사용
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
